      "    await loadPayoutAccount();",
      "  }",
      "  await supabase.from(\"merch_orders\").insert({});",
      "  await adminSupabase.rpc(\"reserve_merch_inventory_for_order\");",
      "  return createCheckoutSession({ product });",
      "}"
