      "    if (!product.is_official) {",
      "      body.set(\"shipping_address_collection[allowed_countries][1]\", \"CA\");",
      "    }",
      "  }",
      "  return createStripeCheckoutSession({ body });",
      "}",
      "export async function POST() {",
      "  const product = await loadProduct();",
      "  const checkoutFlow = product.is_official ? \"official_merch\" : \"marketplace_merch\";",
      "  const checkoutCreationEnabled = stripeCheckoutCreationEnabled(checkoutFlow);",
      "  if (!checkoutCreationEnabled) return redirectWithMessage();",
      "  if (product.is_official && product.shipping_required !== true) {",
      "    return redirectWithMessage();",
      "  }",
      "  if (missingReviewDetails(product)) return redirectWithMessage();",
      "  const adminSupabase = createAdminClient();",
      "  if (!product.is_official) {",
