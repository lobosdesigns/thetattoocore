{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thetattoocore",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "thetattoocore.com",
      "custom_domain": true
    },
    {
      "pattern": "www.thetattoocore.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://ytznkgcslezijkehwjsj.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_8hTy3UyxP93glZU1LN8YiQ_zs-5m2St",
    "TTC_DEVICE_ALERT_SETUP_ENABLED": "true",
    "TTC_NATIVE_PUSH_REGISTRATION_ENABLED": "true",
    "TTC_NATIVE_PUSH_DELIVERY_ENABLED": "false",
    "TTC_SELLER_CHECKOUT_LINKS_ENABLED": "false",
    "TTC_WEB_AD_PURCHASES_ENABLED": "false",
    "TTC_IOS_AD_PURCHASES_ENABLED": "false",
    "TTC_ANDROID_AD_PURCHASES_ENABLED": "false",
    "APPLE_APP_STORE_BUNDLE_ID": "com.thetattoocore.app",
    "APPLE_APP_STORE_APP_ID": "6791179517",
    "APPLE_APP_STORE_ALLOW_SANDBOX": "false",
    "GOOGLE_PLAY_PACKAGE_NAME": "com.thetattoocore.app",
    "GOOGLE_PLAY_ALLOW_TEST_PURCHASES": "false",
    "GOOGLE_PLAY_PUBSUB_AUDIENCE": "https://thetattoocore.com/api/ads/purchases/google/notifications",
    "STRIPE_EXPECTED_LIVEMODE": "false",
    "STRIPE_CHECKOUT_CREATION_ENABLED": "false",
    "STRIPE_OFFICIAL_MERCH_CHECKOUT_ENABLED": "false",
    "STRIPE_MARKETPLACE_MERCH_CHECKOUT_ENABLED": "false",
    "STRIPE_BOOKING_CHECKOUT_ENABLED": "false",
    "STRIPE_CONNECT_ONBOARDING_ENABLED": "false",
    "STRIPE_MERCH_DESTINATION_CHARGES_ENABLED": "false"
  },
  "observability": {
    "enabled": true
  }
}
